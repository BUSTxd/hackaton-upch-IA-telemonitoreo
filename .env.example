# Copiar a .env.local y rellenar. NUNCA subir .env.local al repo.

# Frontend (apps/web). Next solo lee las variables de apps/web/.env.local, no de la raíz.
# URL del backend FastAPI, sin barra final. Ej.: http://localhost:8000
NEXT_PUBLIC_API_URL=

# LiveKit (voz en tiempo real)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Modelos
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
